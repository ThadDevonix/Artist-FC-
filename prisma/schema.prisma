// Artist FC League — data model
// ฐานข้อมูล: PostgreSQL (dev และ prod) ผ่าน @prisma/adapter-pg

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── ผู้ใช้งานหลังบ้าน ─────────────────────────────

enum Role {
  ADMIN // จัดการได้ทุกอย่าง
  REFEREE // บันทึกผลการแข่งขันที่ตัวเองได้รับมอบหมาย
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(REFEREE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  official    Official? // บัญชีนี้เป็นของผู้ตัดสินคนไหน (ถ้ามี) — ใช้ตัดสินสิทธิ์บันทึกผล
  submitted   Match[]    @relation("MatchSubmitter")
  approved    Match[]    @relation("MatchApprover")
  auditEntries AuditLog[]
}

// ───────────────────────────── ผู้ตัดสิน ─────────────────────────────

// ผู้ตัดสินในสนาม — แยกจากบัญชีผู้ใช้ เพราะบางคนไม่ได้ใช้ระบบ
// ถ้าผูกกับบัญชีกรรมการ (userId) คนนั้นจะบันทึกผลนัดที่ตัวเองอยู่ในทีมผู้ตัดสินได้
model Official {
  id          String   @id @default(cuid())
  name        String
  level       String? // ระดับ/สังกัด เช่น "ผู้ตัดสินระดับ 1", "สมาคมฯ ภาคอีสาน"
  nationality String?
  photoUrl    String?
  userId      String?  @unique
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user                User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  refereeMatches      Match[] @relation("MatchReferee")
  assistant1Matches   Match[] @relation("MatchAssistant1")
  assistant2Matches   Match[] @relation("MatchAssistant2")
  fourthOfficialMatch Match[] @relation("MatchFourthOfficial")
  issuedCards         MatchEvent[] @relation("EventIssuer")
}

// ───────────────────────────── ลีก / ฤดูกาล ─────────────────────────────

model Season {
  id        String   @id @default(cuid())
  name      String // "2026–27"
  slug      String   @unique // "2026-27"
  isActive  Boolean  @default(false)
  format    SeasonFormat @default(LEAGUE)
  rounds    Int      @default(1) // 1 = เจอกันรอบเดียว, 2 = เหย้า-เยือน (ฤดูกาลแบบแบ่งกลุ่ม = ในกลุ่ม)
  pointsWin Int      @default(3)
  pointsDraw Int     @default(1)
  pointsLoss Int     @default(0)
  periods       Int  @default(2) // เกมแบ่งกี่ช่วง: 2 = ครึ่งแรก/ครึ่งหลัง, 4 = 4 ควอเตอร์
  periodMinutes Int  @default(45) @map("halfMinutes") // ช่วงละกี่นาที — ใช้กับนาฬิกาถ่ายทอดสด
  // แบ่งกลุ่ม + น็อคเอาต์ (format = CUP)
  groupCount       Int     @default(0) // จำนวนกลุ่ม
  advancePerGroup  Int     @default(2) // ผ่านเข้ารอบกลุ่มละกี่ทีม
  knockoutLegs     Int     @default(1) // 1 = นัดเดียว, 2 = เหย้า-เยือน (นัดชิงนัดเดียวเสมอ)
  extraTime        Boolean @default(false) // เสมอในรอบน็อคเอาต์ → ต่อเวลา 2 ช่วง
  extraTimeMinutes Int     @default(15) // ต่อเวลาช่วงละกี่นาที
  penalties        Boolean @default(true) // ยังเสมอ → ยิงจุดโทษ
  // ลำดับการตัดสินเมื่อคะแนนเท่ากัน เก็บเป็น JSON array เช่น ["GOAL_DIFF","GOALS_FOR","HEAD_TO_HEAD","WINS","NAME"]
  tiebreakers String  @default("[\"GOAL_DIFF\",\"GOALS_FOR\",\"HEAD_TO_HEAD\",\"WINS\",\"NAME\"]")
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams   SeasonTeam[]
  matches Match[]
  zones   Zone[]
}

/// แถบสีด้านซ้ายของตารางคะแนน (โซนแชมเปียนส์ลีก / ตกชั้น ฯลฯ)
model Zone {
  id       String @id @default(cuid())
  seasonId String
  label    String // "ชิงแชมป์"
  color    String // "#1d4ed8"
  fromPos  Int
  toPos    Int

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@index([seasonId])
}

// ───────────────────────────── ทีม / นักเตะ ─────────────────────────────

model Team {
  id        String   @id @default(cuid())
  name      String // "แมนเชสเตอร์ ซิตี"
  shortName String // "แมนซิตี"
  code      String // "MCI"
  slug      String   @unique
  logoUrl   String?
  color     String   @default("#1f2937")
  color2    String? // สีที่ 2 (ไม่บังคับ) — วงกลมจะผ่าครึ่งแนวนอน บนสีหลัก ล่างสีรอง
  venue     String?
  city      String?
  founded   Int?
  // ช่องทีมชั่วคราว ("ทีม 1", "ทีม 2" …) ที่สร้างตอนตั้งฤดูกาลด้วยจำนวนทีม — แทนด้วยสโมสรจริงทีหลัง
  // ไม่แสดงในรายชื่อสโมสร และถูกลบทิ้งเมื่อใส่สโมสรจริงแทนแล้ว
  isPlaceholder Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players     Player[]
  staff       Staff[]
  seasons     SeasonTeam[]
  homeMatches Match[]      @relation("HomeTeam")
  awayMatches Match[]      @relation("AwayTeam")
  events      MatchEvent[]
}

model SeasonTeam {
  id       String @id @default(cuid())
  seasonId String
  teamId   String
  slot     Int? // ช่องที่เท่าไหร่ในตารางแข่ง (1 … จำนวนทีม) — ลำดับที่ใช้จับคู่
  group    Int? // กลุ่มที่เท่าไหร่ (1 = กลุ่ม A) — เฉพาะฤดูกาลแบบแบ่งกลุ่ม

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([seasonId, teamId])
  @@index([seasonId])
}

enum Position {
  GK
  DF
  MF
  FW
}

// ทีมงาน (โค้ช ผู้จัดการ แพทย์ ฯลฯ) — แยกจากนักเตะ เพราะไม่มีเบอร์เสื้อ ไม่ลงสถิติ ไม่ถูกเลือกเป็นผู้ทำประตู
enum StaffRole {
  PRESIDENT
  MANAGER
  HEAD_COACH
  ASSISTANT_COACH
  GK_COACH
  FITNESS_COACH
  DOCTOR
  PHYSIO
  TEAM_OFFICER
  OTHER
}

model Staff {
  id          String    @id @default(cuid())
  teamId      String
  name        String
  role        StaffRole
  roleLabel   String? // ใช้เมื่อ role = OTHER ให้พิมพ์ชื่อตำแหน่งเอง
  photoUrl    String?
  nationality String?
  active      Boolean   @default(true)
  hidden      Boolean   @default(false) // ซ่อนจากหน้าเว็บสาธารณะ
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model Player {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  teamId      String // นักเตะต้องลงทะเบียนกับสโมสรเสมอ
  number      Int?
  position    Position  @default(MF)
  photoUrl    String?
  nationality String?
  birthDate   DateTime?
  active      Boolean   @default(true)
  hidden      Boolean   @default(false) // ซ่อนจากหน้าเว็บสาธารณะ ยังบันทึกเหตุการณ์ในเกมได้ตามปกติ
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team    Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  events  MatchEvent[] @relation("EventPlayer")
  assists MatchEvent[] @relation("EventAssist")

  @@index([teamId])
}

// ───────────────────────────── การแข่งขัน ─────────────────────────────

enum SeasonFormat {
  LEAGUE // ลีกพบกันหมด
  CUP // แบ่งกลุ่ม แล้วต่อด้วยน็อคเอาต์
}

enum MatchStatus {
  SCHEDULED // ยังไม่แข่ง
  LIVE // กำลังแข่ง
  PENDING // กรรมการส่งผลแล้ว รออนุมัติ
  FINISHED // อนุมัติแล้ว นับคะแนน
  POSTPONED // เลื่อน
  CANCELLED // ยกเลิก
}

model Match {
  id         String      @id @default(cuid())
  seasonId   String
  round      Int // นัดที่ (matchweek)
  homeTeamId String
  awayTeamId String
  kickoffAt  DateTime? // ว่าง = ยังไม่กำหนดวันเวลา (ตารางสร้างไว้ก่อน ค่อยตั้งวันทีหลัง)
  venue      String?
  status     MatchStatus @default(SCHEDULED)
  homeGoals  Int?
  awayGoals  Int?
  homePens   Int? // ยิงจุดโทษ — เฉพาะนัดน็อคเอาต์ที่เสมอ
  awayPens   Int?
  notes      String?

  // ฤดูกาลแบบแบ่งกลุ่ม: นัดในกลุ่มมี group · นัดน็อคเอาต์มี koSize (เหลือกี่ทีม เช่น 8, 4, 2 = ชิง) + koSlot (คู่ที่ในรอบ)
  // homeSource/awaySource = ทีมมาจากไหน เช่น "G:1:2" (ที่ 2 กลุ่ม A), "W:8:3" (ผู้ชนะคู่ 3 ของรอบ 8 ทีม)
  group      Int?
  koSize     Int?
  koSlot     Int?
  leg        Int? // เหย้า-เยือน: 1 = นัดแรก, 2 = นัดสอง
  homeSource String?
  awaySource String?

  // นาฬิกาถ่ายทอดสด — ช่วงที่กำลังแข่ง (1…จำนวนช่วงของฤดูกาล) และเวลาที่ช่วงนั้นเริ่ม
  // liveBreak = พักหลังจบช่วง livePeriod · เวลาเดินคำนวณจากตรงนี้ ไม่ต้องบันทึกทุกวินาที
  livePeriod     Int?
  liveBreak      Boolean   @default(false)
  phaseStartedAt DateTime?

  // ทีมผู้ตัดสิน — ผู้ตัดสินที่ 1 คือคนแจกใบเหลือง/แดงทุกใบตามกติกา สถิติผู้ตัดสินนับจากช่องนี้
  refereeId        String?
  assistant1Id     String?
  assistant2Id     String?
  fourthOfficialId String?
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season      Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeTeam    Team   @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam    Team   @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  referee        Official? @relation("MatchReferee", fields: [refereeId], references: [id], onDelete: SetNull)
  assistant1     Official? @relation("MatchAssistant1", fields: [assistant1Id], references: [id], onDelete: SetNull)
  assistant2     Official? @relation("MatchAssistant2", fields: [assistant2Id], references: [id], onDelete: SetNull)
  fourthOfficial Official? @relation("MatchFourthOfficial", fields: [fourthOfficialId], references: [id], onDelete: SetNull)
  submittedBy User?  @relation("MatchSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy  User?  @relation("MatchApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  events MatchEvent[]

  @@index([seasonId, round])
  @@index([status])
}

enum EventType {
  GOAL
  OWN_GOAL
  PENALTY_GOAL
  PENALTY_MISS
  YELLOW
  SECOND_YELLOW
  RED
}

model MatchEvent {
  id             String    @id @default(cuid())
  matchId        String
  teamId         String
  playerId       String?
  assistPlayerId String?
  type           EventType
  minute         Int
  extraMinute    Int? // เวลาทดเจ็บ เช่น 90+3
  issuedById     String? // ผู้ตัดสินที่ให้ใบ (เฉพาะใบเหลือง/แดง) — ว่าง = ผู้ตัดสินที่ 1 ของนัด
  note           String?
  createdAt      DateTime  @default(now())

  match        Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team         Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player       Player? @relation("EventPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  assistPlayer Player? @relation("EventAssist", fields: [assistPlayerId], references: [id], onDelete: SetNull)
  issuedBy     Official? @relation("EventIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([matchId])
  @@index([playerId])
}

// ───────────────────────────── บันทึกการแก้ไข ─────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // "MATCH_SUBMIT" | "MATCH_APPROVE" | "TEAM_UPDATE" ...
  entity    String // "Match" | "Team" ...
  entityId  String
  detail    String? // JSON
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
