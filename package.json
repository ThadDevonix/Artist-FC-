    "test:roster": "tsx scripts/roster-test.ts",
    "test:live": "tsx scripts/live-test.ts",
    "test:season": "tsx scripts/season-delete-test.ts",
    "test:schedule": "tsx scripts/schedule-test.ts",
    "test:export": "tsx scripts/export-test.ts",
    "test:cup": "tsx scripts/cup-test.ts",
    "test": "npm run test:logic && npm run test:theme && npm run test:workflow && npm run test:pages && npm run test:responsive && npm run test:login && npm run test:flow && npm run test:roster && npm run test:live && npm run test:season && npm run test:schedule && npm run test:export && npm run test:cup",
